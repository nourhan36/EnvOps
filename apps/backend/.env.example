# Existing application services
DATABASE_URL="postgresql://username:password@hostname:port/database_name"
REDIS_URL="redis://hostname:port"

# HTTP / Socket.IO server
PORT=3000
APP_ORIGINS="http://hostname:port"

# Local Kubernetes access.
# Leave KUBECONFIG empty when kubectl already uses %USERPROFILE%\.kube\config.
KUBECTL_BIN="kubectl"
KUBECONFIG=""
KUBECTL_CONTEXT=""

# Kubernetes API target for the orchestrator.
KUBERNETES_TARGET="emulator"
# Optional override for the local emulator API server.
KUBERNETES_EMULATOR_SERVER="https://127.0.0.1:6500"
# AWS CLI settings used to mint a Floci-compatible token when no exec user exists in the kubeconfig.
KUBERNETES_EMULATOR_AWS_REGION="us-east-1"
KUBERNETES_EMULATOR_AWS_CLUSTER_NAME="envops-dev-cluster"
# How long to wait for a sandbox Pod to reach Running before failing provisioning.
KUBERNETES_PROVISION_TIMEOUT_MS=300000

# How often the eviction sweep checks for expired sandboxes (ms).
# Expired sandboxes are marked "expired" and their Kubernetes resources are removed.
EVICTION_INTERVAL_MS=60000

# Pod selector used by the terminal backend.
# The search is restricted to the trusted sandbox namespace.
SANDBOX_POD_SELECTOR="app=sandbox"

# Shell opened inside the sandbox container.
# /bin/sh is more portable than /bin/bash.
TERMINAL_SHELL="/bin/sh"
TERMINAL_DEFAULT_COLS=100
TERMINAL_DEFAULT_ROWS=30
TERMINAL_MAX_INPUT_BYTES=65536

# AI Error Interceptor (DeepSeek via the ITI gateway).
# The key is backend-only and must never be exposed to the frontend.
SBG_API_KEY=""
LLM_BASE_URL="http://apiaccess.iti.net.eg/api/v1"
LLM_MODEL_ID="deepseek.v3.2"
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1
LLM_MAX_STDERR_CHARS=8000
AI_ERROR_COOLDOWN_MS=5000
AI_ERROR_DEBOUNCE_MS=500
AI_ERROR_MAX_CAPTURED_CHARS=12000

# AI command translator (/ai <intent> inside the terminal).
AI_RATE_LIMIT_PER_MINUTE=10
AI_MAX_INTENT_CHARS=500
AI_MAX_COMMAND_CHARS=2000

# TEMPORARY MVP AUTHENTICATION.
# replace this with the authenticated user from the Socket.IO handshake.
DEMO_USER_EMAIL="demo@envops.local"
