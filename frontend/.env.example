# Base path for REST calls. Keep as "/api" so requests go same-origin through
# the Vite dev proxy (dev) or nginx (prod). Override only for split deployments.
VITE_API_URL=/api

# Optional. When unset, the socket client connects same-origin via the Vite proxy (/socket.io, ws: true).
# Set this only when the backend runs on a different host/port without a proxy.
# VITE_SOCKET_URL=http://localhost:3000