pipeline {
    agent {
        label 'jenkins-agent'
    }

    environment {
        AWS_REGION = 'us-east-1'
        AWS_ACCOUNT_ID = '524558748637'

        ECR_REPOSITORY = 'envops-dev/frontend'

        IMAGE_TAG = "${BUILD_NUMBER}"

        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"

        IMAGE = "${ECR_REGISTRY}/${ECR_REPOSITORY}:${IMAGE_TAG}"
    }

    stages {

        stage('Check Frontend Changes') {
            steps {
                script {
                    def changedFiles = sh(
                        script: 'git diff --name-only HEAD~1 HEAD',
                        returnStdout: true
                    ).trim()

                    echo "Changed files:"
                    echo changedFiles

                    if (!changedFiles.split('\n').any {
                        it.startsWith('frontend/')
                    }) {
                        currentBuild.result = 'NOT_BUILT'
                        error("No frontend changes detected.")
                    }
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                container('node') {
                    dir('frontend') {
                        sh 'npm ci'
                    }
                }
            }
        }

        stage('Build Frontend') {
            steps {
                container('node') {
                    dir('frontend') {
                        sh 'npm run build'
                    }
                }
            }
        }

        stage('Run Tests') {
            steps {
                container('node') {
                    dir('frontend') {
                        sh 'npm test'
                    }
                }
            }
        }

        stage('Build & Push Image') {
            steps {
                container('kaniko') {
                    sh '''
                        /kaniko/executor \
                          --context ${WORKSPACE}/frontend \
                          --dockerfile ${WORKSPACE}/frontend/Dockerfile \
                          --destination ${IMAGE} \
                          --destination ${ECR_REGISTRY}/${ECR_REPOSITORY}:latest
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Frontend image pushed successfully:"
            echo "${IMAGE}"
        }

        failure {
            echo "Frontend pipeline failed."
        }
    }
}